# Скопировать в .env рядом с compose.yaml (docker compose подхватывает сам). Не обязательный
# файл: без него работают значения по умолчанию. В git .env не попадает (исключён .gitignore).

# Пароль postgres в обеих копиях: он же в строках подключения сервиса server, поэтому источник один
POSTGRES_PASSWORD=postgres

# Задержка обработки запроса на сервере: пока он «думает», узлы успевают обменяться heartbeat
PROCESSING_DELAY_MS=1500
